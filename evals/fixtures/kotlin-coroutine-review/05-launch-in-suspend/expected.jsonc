{
  // latestPrices returns the map immediately (line 18) before any of the
  // launched children have populated it. The caller depends on the result,
  // so this must be wrapped in coroutineScope { symbols.map { async { ... } }
  //   .awaitAll() } — or the launches converted to async.
  // Either category label is defensible: "structured-concurrency-violation"
  // is the direct catalog hit; some reviewers frame it as a scope leak.
  "must_flag": [
